// Prisma schema — gausidigital.com exam portal
// Connection URL is configured in prisma.config.ts (reads DATABASE_URL from env)
// At runtime, the PrismaClient uses the pg adapter (see src/lib/db.ts)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User ─────────────────────────────────────────────────────────────────────
// Lightweight identity — email only, no password, no OTP.
// Email is always stored trimmed + lowercased before writes.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts TestAttempt[]
}

// ─── GeneratedTest ────────────────────────────────────────────────────────────
// AI-generated test papers. Status-driven workflow.
// Agent 1 uses: DRAFT → GENERATING → GENERATED
// Future agents: VALIDATION_FAILED | READY | PUBLISHED | ARCHIVED
model GeneratedTest {
  id               String    @id @default(cuid())
  exam             String    // e.g. "BPSC TRE 4"
  category         String    // e.g. "History"
  topic            String    // e.g. "Revolt of 1857"
  slug             String    @unique
  titleHi          String
  titleEn          String
  difficulty       String    // "Beginner" | "Easy" | "Moderate" | "Hard" | "Mixed"
  totalQuestions   Int
  durationMinutes  Int
  status           String    @default("DRAFT")
  plannedPublishAt DateTime?
  generationSource String    @default("openai")
  generationModel  String?
  generationMs     Int?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  publishAt      DateTime?
  publishedAt    DateTime?
  contentVersion Int       @default(1)

  questions  GeneratedQuestion[]
  validation TestValidation?

  @@index([status, createdAt(sort: Desc)])
  @@index([exam, category, status])
  @@index([status, publishAt])
}

// ─── TestValidation ───────────────────────────────────────────────────────────
// Agent 2 — per-test validation snapshot. One record per test (upserted on revalidation).
model TestValidation {
  id               String        @id @default(cuid())
  testId           String        @unique
  test             GeneratedTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  totalQuestions   Int
  passed           Int
  failed           Int
  reviewNeeded     Int
  overallStatus    String   // "READY" | "VALIDATION_FAILED"
  validationSummary String?

  validatorModel   String?  // e.g. "gpt-4o"
  validationMs     Int?
  validatedAt      DateTime @default(now())
  contentVersion   Int      @default(1)  // snapshot of GeneratedTest.contentVersion at validation time

  questionResults  QuestionValidationResult[]

  @@index([testId])
}

// ─── QuestionValidationResult ─────────────────────────────────────────────────
// Per-question result from Agent 2 validation. Cascade-deleted with TestValidation.
model QuestionValidationResult {
  id           String         @id @default(cuid())
  validationId String
  validation   TestValidation @relation(fields: [validationId], references: [id], onDelete: Cascade)

  questionId   String
  order        Int
  status       String  // "PASS" | "FAIL" | "REVIEW"
  confidence   Float   // 0.0 – 1.0
  issues       Json    @default("[]")
  suggestedFix String?
  factualNotes String?

  @@index([validationId])
  @@index([questionId])
}

// ─── GeneratedQuestion ────────────────────────────────────────────────────────
// Per-question rows. Cascade-deleted with parent GeneratedTest.
// Option E is always hardcoded server-side — never sent to or from AI.
model GeneratedQuestion {
  id            String        @id @default(cuid())
  testId        String
  test          GeneratedTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  order         Int    // 1-based
  category      String
  topic         String
  difficulty    String

  questionHi    String
  optionAHi     String
  optionBHi     String
  optionCHi     String
  optionDHi     String
  optionEHi     String   @default("उत्तर नहीं देना चाहता")
  explanationHi String

  questionEn    String
  optionAEn     String
  optionBEn     String
  optionCEn     String
  optionDEn     String
  optionEEn     String   @default("I do not want to answer")
  explanationEn String

  correctOption String   // "A" | "B" | "C" | "D" — never "E"

  createdAt DateTime @default(now())

  @@unique([testId, order])
  @@index([testId])
}

// ─── DailyAutomationConfig ────────────────────────────────────────────────────
// Agent 4 — Single-row configuration for daily test automation.
// Exactly one row is enforced by application logic.
model DailyAutomationConfig {
  id              String   @id @default(cuid())

  // Test parameters
  exam            String   @default("BPSC TRE 4")
  category        String   @default("History")
  topic           String   @default("")
  difficulty      String   @default("Moderate")
  totalQuestions  Int      @default(25)
  durationMinutes Int      @default(15)

  // Automation toggles
  enabled         Boolean  @default(false)
  autoPublish     Boolean  @default(true)
  allowRepeat     Boolean  @default(false)

  // Agent 5 — Topic source mode
  topicMode       String   @default("MANUAL")  // "MANUAL" | "QUEUE"

  // Timing (IST strings — cron is fixed in vercel.json)
  generateTime    String   @default("04:00")  // HH:MM IST
  publishTime     String   @default("05:00")  // HH:MM IST
  timezone        String   @default("Asia/Kolkata")

  // Run tracking
  lastRunAt       DateTime?
  lastRunStatus   String?   // SUCCESS | FAILED | HELD_FOR_REVIEW | SKIPPED
  nextRunAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs            AutomationRun[]
}

// ─── AutomationRun ────────────────────────────────────────────────────────────
// Agent 4 — Audit log for every daily automation execution.
model AutomationRun {
  id             String                @id @default(cuid())
  configId       String
  config         DailyAutomationConfig @relation(fields: [configId], references: [id])

  // Idempotency key — unique per (config × calendar-day in IST)
  runKey         String                @unique // e.g. "bpsc-tre-4-history-2026-08-21"
  scheduledFor   DateTime              // midnight IST of the run date (stored UTC)

  startedAt      DateTime?
  finishedAt     DateTime?
  status         String                // RUNNING | SUCCESS | FAILED | HELD_FOR_REVIEW | SKIPPED

  generatedTestId      String?
  generationStatus     String?
  validationStatus     String?
  publicationStatus    String?

  errorStage     String?  // GENERATION | VALIDATION | PUBLICATION | TOPIC_GUARD
  errorMessage   String?

  generationDurationMs Int?
  validationDurationMs Int?

  // Snapshot of config at run time (for history display)
  topic          String?
  category       String?
  exam           String?
  totalQuestions Int?

  // Agent 5 — Topic Planner tracking
  selectedTopicId      String?  // FK to ExamTopic (soft ref — no Prisma relation to keep migration simple)
  topicSelectionSource String?  // "MANUAL" | "QUEUE"

  createdAt      DateTime @default(now())

  @@index([configId, scheduledFor])
  @@index([status])
}

// ─── ExamTopic ────────────────────────────────────────────────────────────────
// Agent 5 — Topic Planner queue. Admin maintains this list; Agent 5 picks the
// next eligible topic for each daily automation run.
//
// Topic consumption rules (documented here for consistency):
//   • Generation fails before test is created → lastUsedAt NOT updated
//   • Generation succeeds (test created) → lastUsedAt IS updated, timesUsed++
//     even if validation later fails — a complete paper was generated.
model ExamTopic {
  id    String @id @default(cuid())
  exam  String // e.g. "BPSC TRE 4"
  category String // e.g. "History"
  topic    String // e.g. "Revolt of 1857"
  slug     String @unique // URL-safe identifier

  // Per-topic defaults (null = fall back to DailyAutomationConfig)
  difficultyDefault      String? // "Beginner" | "Easy" | "Moderate" | "Hard" | "Mixed"
  questionCountDefault   Int?
  durationMinutesDefault Int?

  // Queue behaviour
  priority         Int      @default(50)   // higher number = higher priority (100=high, 50=normal, 10=low)
  sequenceOrder    Int?                    // optional manual ordering within same priority
  cooldownDays     Int      @default(30)   // days before topic can repeat
  earliestUseDate  DateTime?               // do not select before this date
  preferredDayOfWeek Int?                  // 0=Sun…6=Sat, null=any
  notes            String?

  // State
  enabled Boolean @default(true)
  status  String  @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED" | "ARCHIVED"

  // Usage tracking
  lastUsedAt DateTime?
  timesUsed  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([exam, status, priority(sort: Desc)])
  @@index([exam, category, status])
}

// ─── TestAttempt ──────────────────────────────────────────────────────────────
// Every submission creates a new row. Old rows are never overwritten.
// The result snapshot (score, answers) is fixed at submission time.
// If marking config changes later, historical scores are unaffected.
model TestAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Test identity
  testId    String
  testSlug  String
  testTitle String
  subject   String?
  topic     String?

  // Submission metadata
  language         String
  startedAt        DateTime
  submittedAt      DateTime
  submissionReason String // "manual" | "timeout"
  timeUsedSeconds  Int

  // Frozen score snapshot (server-calculated at submission time)
  score      Float
  maxScore   Float
  correct    Int
  wrong      Int
  optionE    Int
  unanswered Int
  attempted  Int
  accuracy   Float
  percentage Float

  // Per-question answer snapshot (JSON array of AnswerSnapshot)
  answers Json

  // Per-category breakdown (JSON array of CategoryResult)
  topicBreakdown Json?

  // Idempotency key — client generates once, server enforces uniqueness
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  @@index([userId, submittedAt(sort: Desc)])
  @@index([userId, testId])
}
