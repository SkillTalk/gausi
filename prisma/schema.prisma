// Prisma schema — gausidigital.com exam portal
// Connection URL is configured in prisma.config.ts (reads DATABASE_URL from env)
// At runtime, the PrismaClient uses the pg adapter (see src/lib/db.ts)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User ─────────────────────────────────────────────────────────────────────
// Lightweight identity — email only, no password, no OTP.
// Email is always stored trimmed + lowercased before writes.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts TestAttempt[]
}

// ─── GeneratedTest ────────────────────────────────────────────────────────────
// AI-generated test papers. Status-driven workflow.
// Agent 1 uses: DRAFT → GENERATING → GENERATED
// Future agents: VALIDATION_FAILED | READY | PUBLISHED | ARCHIVED
model GeneratedTest {
  id               String    @id @default(cuid())
  exam             String    // e.g. "BPSC TRE 4"
  category         String    // e.g. "History"
  topic            String    // e.g. "Revolt of 1857"
  slug             String    @unique
  titleHi          String
  titleEn          String
  difficulty       String    // "Beginner" | "Easy" | "Moderate" | "Hard" | "Mixed"
  totalQuestions   Int
  durationMinutes  Int
  status           String    @default("DRAFT")
  plannedPublishAt DateTime?
  generationSource String    @default("openai")
  generationModel  String?
  generationMs     Int?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  publishAt      DateTime?
  publishedAt    DateTime?
  contentVersion Int       @default(1)

  questions  GeneratedQuestion[]
  validation TestValidation?

  @@index([status, createdAt(sort: Desc)])
  @@index([exam, category, status])
  @@index([status, publishAt])
}

// ─── TestValidation ───────────────────────────────────────────────────────────
// Agent 2 — per-test validation snapshot. One record per test (upserted on revalidation).
model TestValidation {
  id               String        @id @default(cuid())
  testId           String        @unique
  test             GeneratedTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  totalQuestions   Int
  passed           Int
  failed           Int
  reviewNeeded     Int
  overallStatus    String   // "READY" | "VALIDATION_FAILED"
  validationSummary String?

  validatorModel   String?  // e.g. "gpt-4o"
  validationMs     Int?
  validatedAt      DateTime @default(now())
  contentVersion   Int      @default(1)  // snapshot of GeneratedTest.contentVersion at validation time

  questionResults  QuestionValidationResult[]

  @@index([testId])
}

// ─── QuestionValidationResult ─────────────────────────────────────────────────
// Per-question result from Agent 2 validation. Cascade-deleted with TestValidation.
model QuestionValidationResult {
  id           String         @id @default(cuid())
  validationId String
  validation   TestValidation @relation(fields: [validationId], references: [id], onDelete: Cascade)

  questionId   String
  order        Int
  status       String  // "PASS" | "FAIL" | "REVIEW"
  confidence   Float   // 0.0 – 1.0
  issues       Json    @default("[]")
  suggestedFix String?
  factualNotes String?

  @@index([validationId])
  @@index([questionId])
}

// ─── GeneratedQuestion ────────────────────────────────────────────────────────
// Per-question rows. Cascade-deleted with parent GeneratedTest.
// Option E is always hardcoded server-side — never sent to or from AI.
model GeneratedQuestion {
  id            String        @id @default(cuid())
  testId        String
  test          GeneratedTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  order         Int    // 1-based
  category      String
  topic         String
  difficulty    String

  questionHi    String
  optionAHi     String
  optionBHi     String
  optionCHi     String
  optionDHi     String
  optionEHi     String   @default("उत्तर नहीं देना चाहता")
  explanationHi String

  questionEn    String
  optionAEn     String
  optionBEn     String
  optionCEn     String
  optionDEn     String
  optionEEn     String   @default("I do not want to answer")
  explanationEn String

  correctOption String   // "A" | "B" | "C" | "D" — never "E"

  createdAt DateTime @default(now())

  @@unique([testId, order])
  @@index([testId])
}

// ─── TestAttempt ──────────────────────────────────────────────────────────────
// Every submission creates a new row. Old rows are never overwritten.
// The result snapshot (score, answers) is fixed at submission time.
// If marking config changes later, historical scores are unaffected.
model TestAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Test identity
  testId    String
  testSlug  String
  testTitle String
  subject   String?
  topic     String?

  // Submission metadata
  language         String
  startedAt        DateTime
  submittedAt      DateTime
  submissionReason String // "manual" | "timeout"
  timeUsedSeconds  Int

  // Frozen score snapshot (server-calculated at submission time)
  score      Float
  maxScore   Float
  correct    Int
  wrong      Int
  optionE    Int
  unanswered Int
  attempted  Int
  accuracy   Float
  percentage Float

  // Per-question answer snapshot (JSON array of AnswerSnapshot)
  answers Json

  // Per-category breakdown (JSON array of CategoryResult)
  topicBreakdown Json?

  // Idempotency key — client generates once, server enforces uniqueness
  idempotencyKey String @unique

  createdAt DateTime @default(now())

  @@index([userId, submittedAt(sort: Desc)])
  @@index([userId, testId])
}
